# PostgreSQL connection string.
# Local:  postgres://postgres:postgres@localhost:5432/vetcare
# Neon:   postgres://<user>:<password>@<host>.neon.tech/<db>?sslmode=require
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vetcare

# Force SSL on/off explicitly if auto-detection (based on "localhost" in
# DATABASE_URL) doesn't do what you want. Neon needs this to be true.
PGSSL=false

# Long random string — never commit the real value.
JWT_SECRET=replace_this_with_a_long_random_string

PORT=4000
NODE_ENV=development

# Comma-separated list of allowed frontend origins, e.g.:
# CLIENT_ORIGIN=https://your-app.netlify.app,http://localhost:5500
CLIENT_ORIGIN=*
